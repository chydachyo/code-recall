{
  "name": "code-recall",
  "displayName": "Code Recall",
  "publisher": "chydachyo",
  "author": {
    "name": "Лукьянов Егор Юрьевич",
    "group": "M3113"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chydachyo/code-recall.git"
  },
  "description": "Тренажёр восстановления выделенного кода по памяти.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "code-recall.start",
        "title": "Начать тренировку по выделенному коду",
        "category": "Code Recall"
      },
      {
        "command": "code-recall.compare",
        "title": "Сравнить с оригиналом",
        "category": "Code Recall"
      },
      {
        "command": "code-recall.resume",
        "title": "Вернуться к попытке",
        "category": "Code Recall"
      },
      {
        "command": "code-recall.finish",
        "title": "Завершить тренировку",
        "category": "Code Recall"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "code-recall.start",
          "when": "editorHasSelection && !inDiffEditor && resourceScheme != code-recall",
          "group": "navigation@100"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:logic": "npm run compile-tests && node --test scripts/test-logic.cjs",
    "package:offline": "npm run package && node scripts/package-vsix.cjs"
  },
  "devDependencies": {
    "@types/vscode": "^1.144.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "jszip": "^3.10.2"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
